{
  "name": "orvi-language",
  "displayName": "Orvi Language",
  "description": "Language support, diagnostics, completions, and preview for Orvi markup.",
  "version": "0.1.0",
  "publisher": "jake-w-liu",
  "license": "MIT",
  "preview": true,
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.92.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jake-w-liu/orvi.git",
    "directory": "vscode/orvi"
  },
  "bugs": {
    "url": "https://github.com/jake-w-liu/orvi/issues"
  },
  "homepage": "https://github.com/jake-w-liu/orvi#readme",
  "keywords": [
    "orvi",
    "markup",
    "language",
    "preview",
    "syntax"
  ],
  "activationEvents": [
    "onLanguage:orvi",
    "onCommand:orvi.preview"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "orvi",
        "aliases": [
          "Orvi",
          "orvi"
        ],
        "extensions": [
          ".ov"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orvi",
        "scopeName": "source.orvi",
        "path": "./syntaxes/orvi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "orvi",
        "path": "./snippets/orvi.json"
      }
    ],
    "commands": [
      {
        "command": "orvi.preview",
        "title": "Orvi: Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "orvi.preview",
          "when": "resourceLangId == orvi",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "orvi.preview",
          "when": "resourceLangId == orvi"
        }
      ]
    },
    "configuration": {
      "title": "Orvi",
      "properties": {
        "orvi.cliPath": {
          "type": "string",
          "default": "orvi",
          "description": "Path to the Orvi CLI executable used for diagnostics and preview."
        }
      }
    }
  }
}
