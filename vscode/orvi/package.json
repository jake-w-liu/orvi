{
  "name": "orvi-language",
  "displayName": "Orvi Language",
  "description": "Language support, diagnostics, completions, and preview for Orvi markup.",
  "version": "0.1.6",
  "publisher": "jake-w-liu",
  "license": "MIT",
  "preview": true,
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.92.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jake-w-liu/orvi.git",
    "directory": "vscode/orvi"
  },
  "bugs": {
    "url": "https://github.com/jake-w-liu/orvi/issues"
  },
  "homepage": "https://github.com/jake-w-liu/orvi#readme",
  "keywords": [
    "orvi",
    "markup",
    "language",
    "preview",
    "syntax"
  ],
  "activationEvents": [
    "onLanguage:orvi"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "scripts": {
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "package": "npm run prepare-runtime && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "orvi",
        "aliases": [
          "Orvi",
          "orvi"
        ],
        "extensions": [
          ".ov"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orvi",
        "scopeName": "source.orvi",
        "path": "./syntaxes/orvi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "orvi",
        "path": "./snippets/orvi.json"
      }
    ],
    "commands": [
      {
        "command": "orvi.preview",
        "title": "Orvi: Open Preview",
        "category": "Orvi"
      },
      {
        "command": "orvi.previewToSide",
        "title": "Orvi: Open Preview to the Side",
        "category": "Orvi"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "orvi.previewToSide",
          "when": "resourceLangId == orvi",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "orvi.preview",
          "when": "resourceLangId == orvi",
          "group": "navigation@1"
        },
        {
          "command": "orvi.previewToSide",
          "when": "resourceLangId == orvi",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "orvi.preview",
          "when": "resourceExtname == .ov",
          "group": "navigation@1"
        },
        {
          "command": "orvi.previewToSide",
          "when": "resourceExtname == .ov",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "orvi.preview",
          "when": "resourceLangId == orvi"
        },
        {
          "command": "orvi.previewToSide",
          "when": "resourceLangId == orvi"
        }
      ]
    },
    "keybindings": [
      {
        "command": "orvi.preview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == orvi"
      },
      {
        "command": "orvi.previewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == orvi"
      }
    ],
    "configuration": {
      "title": "Orvi",
      "properties": {
        "orvi.cliPath": {
          "type": "string",
          "default": "orvi",
          "description": "Optional path to an external Orvi CLI executable. The bundled CLI is used by default."
        }
      }
    }
  }
}
