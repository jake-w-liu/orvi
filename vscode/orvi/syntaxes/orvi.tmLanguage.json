{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Orvi",
  "scopeName": "source.orvi",
  "patterns": [
    { "include": "#comments" },
    { "include": "#fenced-code" },
    { "include": "#headings" },
    { "include": "#semantic" },
    { "include": "#component-tags" },
    { "include": "#inline-scopes" },
    { "include": "#tables" },
    { "include": "#lists" },
    { "include": "#inline-markup" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ov",
          "match": "^\\s*//.*$"
        }
      ]
    },
    "fenced-code": {
      "patterns": [
        {
          "name": "markup.fenced_code.block.ov",
          "begin": "^\\s*(```)\\s*([A-Za-z0-9_-]+)?(?:\\s*(\\|)\\s*([^`]+))?\\s*$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.raw.begin.ov" },
            "2": { "name": "entity.name.type.language.ov" },
            "3": { "name": "punctuation.separator.filename.ov" },
            "4": { "name": "string.unquoted.filename.ov" }
          },
          "end": "^\\s*(```)\\s*$",
          "endCaptures": {
            "1": { "name": "punctuation.definition.raw.end.ov" }
          }
        }
      ]
    },
    "headings": {
      "patterns": [
        {
          "name": "markup.heading.ov",
          "match": "^(#{1,6})\\s+(.+)$",
          "captures": {
            "1": { "name": "punctuation.definition.heading.ov" },
            "2": { "name": "entity.name.section.ov" }
          }
        }
      ]
    },
    "semantic": {
      "patterns": [
        {
          "name": "support.function.semantic.ov",
          "match": "^\\s*(btn|img|hr|br|badge)(:)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.control.semantic.ov" },
            "2": { "name": "punctuation.separator.key-value.ov" },
            "3": { "name": "string.unquoted.semantic-payload.ov" }
          }
        }
      ]
    },
    "component-tags": {
      "patterns": [
        {
          "name": "meta.tag.block.begin.ov",
          "match": "^\\s*(\\[)(callout|grid|card|tabs|tab)(?:\\s+([^\\]]+))?(\\])\\s*$",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.ov" },
            "2": { "name": "entity.name.tag.component.ov" },
            "3": { "name": "meta.attributes.ov" },
            "4": { "name": "punctuation.definition.tag.end.ov" }
          }
        },
        {
          "name": "meta.tag.block.end.ov",
          "match": "^\\s*(\\[\\/)(callout|grid|card|tabs|tab)(\\])\\s*$",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.ov" },
            "2": { "name": "entity.name.tag.component.ov" },
            "3": { "name": "punctuation.definition.tag.end.ov" }
          }
        }
      ]
    },
    "inline-scopes": {
      "patterns": [
        {
          "name": "meta.inline-scope.ov",
          "match": "(\\[)(?=(?:red|blue|green|gray|muted|yellow|purple|orange|pink|cyan|white|black|xs|sm|md|lg|xl|2xl|light|regular|medium|bold|bg=)[^\\]]*\\])([^\\]]+)(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.scope.begin.ov" },
            "2": { "name": "support.constant.modifier.ov" },
            "3": { "name": "punctuation.definition.scope.end.ov" }
          }
        },
        {
          "name": "punctuation.definition.scope.close.ov",
          "match": "\\[\\]"
        }
      ]
    },
    "tables": {
      "patterns": [
        {
          "name": "markup.table.row.ov",
          "match": "^\\s*\\|.*\\|\\s*$"
        }
      ]
    },
    "lists": {
      "patterns": [
        {
          "name": "markup.list.unnumbered.ov",
          "match": "^\\s*[-*]\\s+.+$"
        },
        {
          "name": "markup.list.numbered.ov",
          "match": "^\\s*\\d+\\.\\s+.+$"
        }
      ]
    },
    "inline-markup": {
      "patterns": [
        {
          "name": "markup.bold.ov",
          "match": "\\*\\*[^*]+\\*\\*"
        },
        {
          "name": "markup.italic.ov",
          "match": "_[^_]+_"
        },
        {
          "name": "markup.strikethrough.ov",
          "match": "~~[^~]+~~"
        }
      ]
    }
  }
}
