{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lux",
  "scopeName": "source.lux",
  "patterns": [
    { "include": "#comments" },
    { "include": "#fenced-code" },
    { "include": "#headings" },
    { "include": "#semantic" },
    { "include": "#component-tags" },
    { "include": "#inline-scopes" },
    { "include": "#tables" },
    { "include": "#lists" },
    { "include": "#inline-markup" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lux",
          "match": "^\\s*//.*$"
        }
      ]
    },
    "fenced-code": {
      "patterns": [
        {
          "name": "markup.fenced_code.block.lux",
          "begin": "^\\s*(```)\\s*([A-Za-z0-9_-]+)?(?:\\s*(\\|)\\s*([^`]+))?\\s*$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.raw.begin.lux" },
            "2": { "name": "entity.name.type.language.lux" },
            "3": { "name": "punctuation.separator.filename.lux" },
            "4": { "name": "string.unquoted.filename.lux" }
          },
          "end": "^\\s*(```)\\s*$",
          "endCaptures": {
            "1": { "name": "punctuation.definition.raw.end.lux" }
          }
        }
      ]
    },
    "headings": {
      "patterns": [
        {
          "name": "markup.heading.lux",
          "match": "^(#{1,6})\\s+(.+)$",
          "captures": {
            "1": { "name": "punctuation.definition.heading.lux" },
            "2": { "name": "entity.name.section.lux" }
          }
        }
      ]
    },
    "semantic": {
      "patterns": [
        {
          "name": "support.function.semantic.lux",
          "match": "^\\s*(btn|img|hr|br|badge)(:)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.control.semantic.lux" },
            "2": { "name": "punctuation.separator.key-value.lux" },
            "3": { "name": "string.unquoted.semantic-payload.lux" }
          }
        }
      ]
    },
    "component-tags": {
      "patterns": [
        {
          "name": "meta.tag.block.begin.lux",
          "match": "^\\s*(\\[)(callout|grid|card|tabs|tab)(?:\\s+([^\\]]+))?(\\])\\s*$",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.lux" },
            "2": { "name": "entity.name.tag.component.lux" },
            "3": { "name": "meta.attributes.lux" },
            "4": { "name": "punctuation.definition.tag.end.lux" }
          }
        },
        {
          "name": "meta.tag.block.end.lux",
          "match": "^\\s*(\\[\\/)(callout|grid|card|tabs|tab)(\\])\\s*$",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.lux" },
            "2": { "name": "entity.name.tag.component.lux" },
            "3": { "name": "punctuation.definition.tag.end.lux" }
          }
        }
      ]
    },
    "inline-scopes": {
      "patterns": [
        {
          "name": "meta.inline-scope.lux",
          "match": "(\\[)(?=(?:red|blue|green|gray|muted|yellow|purple|orange|pink|cyan|white|black|xs|sm|md|lg|xl|2xl|light|regular|medium|bold|bg=)[^\\]]*\\])([^\\]]+)(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.scope.begin.lux" },
            "2": { "name": "support.constant.modifier.lux" },
            "3": { "name": "punctuation.definition.scope.end.lux" }
          }
        },
        {
          "name": "punctuation.definition.scope.close.lux",
          "match": "\\[\\]"
        }
      ]
    },
    "tables": {
      "patterns": [
        {
          "name": "markup.table.row.lux",
          "match": "^\\s*\\|.*\\|\\s*$"
        }
      ]
    },
    "lists": {
      "patterns": [
        {
          "name": "markup.list.unnumbered.lux",
          "match": "^\\s*[-*]\\s+.+$"
        },
        {
          "name": "markup.list.numbered.lux",
          "match": "^\\s*\\d+\\.\\s+.+$"
        }
      ]
    },
    "inline-markup": {
      "patterns": [
        {
          "name": "markup.bold.lux",
          "match": "\\*\\*[^*]+\\*\\*"
        },
        {
          "name": "markup.italic.lux",
          "match": "_[^_]+_"
        },
        {
          "name": "markup.strikethrough.lux",
          "match": "~~[^~]+~~"
        }
      ]
    }
  }
}
