{
  "name": "lux-language",
  "displayName": "Lux Language",
  "description": "Language support, diagnostics, completions, and preview for Lux markup.",
  "version": "0.1.0",
  "publisher": "jake-w-liu",
  "license": "MIT",
  "preview": true,
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.92.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jake-w-liu/lux.git",
    "directory": "vscode/lux"
  },
  "bugs": {
    "url": "https://github.com/jake-w-liu/lux/issues"
  },
  "homepage": "https://github.com/jake-w-liu/lux#readme",
  "keywords": [
    "lux",
    "markup",
    "language",
    "preview",
    "syntax"
  ],
  "activationEvents": ["onLanguage:lux", "onCommand:lux.preview"],
  "categories": ["Programming Languages", "Other"],
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "lux",
        "aliases": ["Lux", "lux"],
        "extensions": [".lux"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lux",
        "scopeName": "source.lux",
        "path": "./syntaxes/lux.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lux",
        "path": "./snippets/lux.json"
      }
    ],
    "commands": [
      {
        "command": "lux.preview",
        "title": "Lux: Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lux.preview",
          "when": "resourceLangId == lux",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lux.preview",
          "when": "resourceLangId == lux"
        }
      ]
    },
    "configuration": {
      "title": "Lux",
      "properties": {
        "lux.cliPath": {
          "type": "string",
          "default": "lux",
          "description": "Path to the Lux CLI executable used for diagnostics."
        }
      }
    }
  }
}
