{
  "name": "orvi",
  "version": "0.1.1",
  "description": "Orvi markup parser, HTML renderer, and CLI.",
  "license": "MIT",
  "keywords": [
    "orvi",
    "markup",
    "parser",
    "renderer",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jake-w-liu/orvi.git"
  },
  "homepage": "https://github.com/jake-w-liu/orvi#readme",
  "bugs": {
    "url": "https://github.com/jake-w-liu/orvi/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/esm/parser.js",
      "require": "./dist/parser.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/esm/renderer.js",
      "require": "./dist/renderer.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "import": "./dist/esm/formatter.js",
      "require": "./dist/formatter.js"
    },
    "./artifact": {
      "types": "./dist/artifact.d.ts",
      "import": "./dist/esm/artifact.js",
      "require": "./dist/artifact.js"
    },
    "./prettier-plugin": {
      "types": "./dist/prettier-plugin.d.ts",
      "import": "./dist/esm/prettier-plugin.js",
      "require": "./dist/prettier-plugin.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/esm/react.js",
      "require": "./dist/react.js"
    },
    "./orvi-base.css": "./dist/orvi-base.css"
  },
  "bin": {
    "orvi": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/orvi-base.css",
    "schemas",
    "orvi-spec-v0.1.md",
    "orvi.config.example.js"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:assets",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/prepare-esm.mjs",
    "build:assets": "node -e \"require('fs').copyFileSync('src/orvi-base.css','dist/orvi-base.css')\"",
    "check": "tsc --noEmit",
    "format:check": "prettier --plugin ./dist/prettier-plugin.js --parser orvi examples/welcome.ov --check",
    "finetune:corpus": "node scripts/build-fine-tuning-corpus.mjs",
    "finetune:corpus:check": "node scripts/build-fine-tuning-corpus.mjs --check",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "playground:test": "node --test playground/playground.test.mjs",
    "obsidian:build": "npm run build && node integrations/obsidian-orvi/build.mjs",
    "site:build": "npm run build && node dist/cli.js build examples/welcome.ov -o examples/welcome.html && node scripts/build-site.mjs",
    "verify": "npm run check && npm run finetune:corpus:check && npm test && npm run playground:test && npm run build && npm run format:check",
    "vscode:package": "npm --prefix vscode/orvi run package --"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.14",
    "jest": "^30.0.5",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  }
}
