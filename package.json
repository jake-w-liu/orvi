{
  "name": "@lux-lang/lux",
  "version": "0.1.0",
  "description": "Lux markup parser, HTML renderer, and CLI.",
  "license": "MIT",
  "keywords": [
    "lux",
    "markup",
    "parser",
    "renderer",
    "cli"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/esm/parser.js",
      "require": "./dist/parser.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/esm/renderer.js",
      "require": "./dist/renderer.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "import": "./dist/esm/formatter.js",
      "require": "./dist/formatter.js"
    },
    "./prettier-plugin": {
      "types": "./dist/prettier-plugin.d.ts",
      "import": "./dist/esm/prettier-plugin.js",
      "require": "./dist/prettier-plugin.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/esm/react.js",
      "require": "./dist/react.js"
    },
    "./lux-base.css": "./dist/lux-base.css"
  },
  "bin": {
    "lux": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/lux-base.css",
    "vscode/lux",
    "lux-spec-v0.1.md",
    "lux.config.example.js"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:assets",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/prepare-esm.mjs",
    "build:assets": "node -e \"require('fs').copyFileSync('src/lux-base.css','dist/lux-base.css')\"",
    "check": "tsc --noEmit",
    "format:check": "prettier --plugin ./dist/prettier-plugin.js --parser lux examples/welcome.lux --check",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "playground:test": "node --test playground/playground.test.mjs",
    "verify": "npm run check && npm test && npm run playground:test && npm run build && npm run format:check",
    "vscode:package": "npm --prefix vscode/lux run package"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.14",
    "jest": "^30.0.5",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  }
}
